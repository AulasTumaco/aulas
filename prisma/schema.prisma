generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Salon {
  id             Int       @id @default(autoincrement())
  codigo         String    @unique
  nombre         String
  edificio       String
  capacidad      Int
  tieneProyector Boolean
  tieneAC        Boolean
  tieneTablero   Boolean
  reservas       Reserva[]
}

model Reserva {
  id          Int      @id @default(autoincrement())
  horaInicio  DateTime
  horaFin     DateTime
  salonId     Int
  salon       Salon    @relation(fields: [salonId], references: [id])
  materiaId   Int
  materia     Materia  @relation(fields: [materiaId], references: [id])
  docenteId   Int
  docente     Docente  @relation(fields: [docenteId], references: [id])
  estado      String
}

model Materia {
  id           Int       @id @default(autoincrement())
  nombre       String
  matriculados Int
  reservas     Reserva[]
}

model Docente {
  id             Int       @id @default(autoincrement())
  nombreCompleto String
  reservas       Reserva[]
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
}

model ProgramaAcademico {
  id     Int    @id @default(autoincrement())
  nombre String
}
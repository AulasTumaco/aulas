generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  fullName String // Campo necesario para auth.service
}

model Salon {
  id             Int       @id @default(autoincrement())
  codigo         String    @unique
  nombre         String
  edificio       String
  capacidad      Int
  tieneProyector Boolean   @default(false)
  tieneAC        Boolean   @default(false)
  tieneTablero   Boolean   @default(false)
  reservas       Reserva[]
}

model Reserva {
  id          Int      @id @default(autoincrement())
  fecha       DateTime // Campo necesario para reservas.service
  horaInicio  DateTime
  horaFin     DateTime
  salonId     Int
  salon       Salon    @relation(fields: [salonId], references: [id])
  materiaId   Int
  materia     Materia  @relation(fields: [materiaId], references: [id])
  docenteId   Int
  docente     Docente  @relation(fields: [docenteId], references: [id])
  estado      String
}

model Materia {
  id           Int       @id @default(autoincrement())
  nombre       String
  matriculados Int
  programaId   Int
  programa     ProgramaAcademico @relation(fields: [programaId], references: [id])
  reservas     Reserva[]
}

model Docente {
  id             Int       @id @default(autoincrement())
  nombreCompleto String
  programaId     Int
  programa       ProgramaAcademico @relation(fields: [programaId], references: [id])
  reservas       Reserva[]
}

model ProgramaAcademico {
  id        Int       @id @default(autoincrement())
  nombre    String
  materias  Materia[]
  docentes  Docente[]
}
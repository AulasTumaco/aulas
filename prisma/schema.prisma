generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Salon {
  id        Int       @id @default(autoincrement())
  codigo    String    @unique
  nombre    String
  // ... resto de campos
  reservas  Reserva[]
}

model Reserva {
  id          Int      @id @default(autoincrement())
  fechaInicio DateTime
  fechaFin    DateTime
  salon       Salon    @relation(fields: [salonId], references: [id])
  salonId     Int
  // ... resto de campos
}
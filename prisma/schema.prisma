datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // Recuerda tener tu variable de entorno configurada
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum RolUsuario {
  ADMIN
  DOCENTE
}

enum EstadoReserva {
  LIBRE
  OCUPADO
  RESERVADO
}

// ==========================================
// MODELOS DE USUARIO Y AUTENTICACIÓN
// ==========================================

model User {
  id        Int        @id @default(autoincrement())
  email     String     @unique
  password  String
  fullName  String
  rol       RolUsuario @default(DOCENTE)
  createdAt DateTime   @default(now())
}

// ==========================================
// MODELOS ACADÉMICOS
// ==========================================

model ProgramaAcademico {
  id        Int      @id @default(autoincrement())
  nombre    String   @unique
  createdAt DateTime @default(now())

  materias Materia[]
  docentes Docente[]
}

model Salon {
  id             Int      @id @default(autoincrement())
  codigo         String   @unique
  nombre         String
  edificio       String
  capacidad      Int
  tieneProyector Boolean  @default(false)
  tieneAC        Boolean  @default(false)
  tieneTablero   Boolean  @default(true)
  createdAt      DateTime @default(now())

  reservas Reserva[]

  @@index([edificio])
}

model Materia {
  id                  Int      @id @default(autoincrement())
  codigo              String   @unique
  nombre              String
  matriculados        Int
  programaAcademicoId Int
  createdAt           DateTime @default(now())

  programa ProgramaAcademico @relation(fields: [programaAcademicoId], references: [id], onDelete: Restrict)
  reservas Reserva[]

  @@index([programaAcademicoId])
}

model Docente {
  id                  Int      @id @default(autoincrement())
  nombreCompleto      String
  correo              String   @unique
  programaAcademicoId Int
  createdAt           DateTime @default(now())

  programa ProgramaAcademico @relation(fields: [programaAcademicoId], references: [id], onDelete: Restrict)
  reservas Reserva[]

  @@index([programaAcademicoId])
}

// ==========================================
// MODELO DE RESERVAS (GESTIÓN DE HORARIOS)
// ==========================================

model Reserva {
  id        Int           @id @default(autoincrement())
  salonId   Int
  materiaId Int
  docenteId Int
  
  // Optimización: Unificamos fecha y hora para evitar problemas de desfase
  fechaInicio DateTime
  fechaFin    DateTime
  
  estado    EstadoReserva @default(RESERVADO)
  createdAt DateTime      @default(now())

  salon   Salon   @relation(fields: [salonId],   references: [id], onDelete: Restrict)
  materia Materia @relation(fields: [materiaId], references: [id], onDelete: Restrict)
  docente Docente @relation(fields: [docenteId], references: [id], onDelete: Restrict)

  @@index([salonId])
  @@index([fechaInicio])
  @@index([fechaFin])
}